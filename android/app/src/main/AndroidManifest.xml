<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Usage Access. This is not a runtime permission: it cannot be requested
      with a prompt, only granted by hand in Settings, which is why the app
      checks for it and sends you there rather than asking.

      tools:ignore is required because the linter assumes an app declaring this
      is a system app. It is declared here for exactly one purpose: reading this
      device's own foreground intervals, on this device, to show you a total.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      There is deliberately no INTERNET permission, and adding one would not
      currently buy anything.

      The AI planner and review are protected procedures: they need a signed-in
      user. Sign-in is OAuth, and the redirect URI is built from
      window.location.origin — which inside this app is the asset loader's
      placeholder domain, not a real host. The callback could never come back,
      so the AI features cannot work from bundled assets however many
      permissions are granted.

      Making them work means loading the course from its real deployed origin
      rather than from the APK, which is a different design and needs that URL.
      Until then, this permission would weaken a real guarantee — that usage
      data never leaves the device, enforced by the system — in exchange for
      nothing. Sly builds today's schedule on the device instead.
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HundredSteps">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
