# Hundred Steps to Life — environment configuration
#
# Copy to `.env` and fill in. In the hosted Manus project every value below is
# platform-provided; you only need this file when running the app elsewhere.
#
# None of these are required to take the course itself. The curriculum, the
# island map and the local journal all work with an empty file — these variables
# enable sign-in, server-side journal backup and the optional integrations.

# --- Server ---

# Port the Express server listens on. Defaults to 3000.
PORT=3000

# MySQL connection string used by Drizzle ORM.
# Required for sign-in and journal backup.
DATABASE_URL=mysql://user:password@localhost:3306/hundred_steps

# Secret used to sign the session cookie. Use a long random value.
JWT_SECRET=

# Manus OAuth server, used server-side to exchange the authorisation code.
OAUTH_SERVER_URL=

# Manus openId of the project owner, granted the "admin" role.
OWNER_OPEN_ID=

# --- Client (exposed to the browser — never put secrets here) ---

# Manus application id. Read by both the server and the client.
VITE_APP_ID=

# Manus OAuth portal the sign-in button redirects to.
VITE_OAUTH_PORTAL_URL=

# --- Optional platform integrations ---

# Server-side Forge API, backing image generation, LLM and voice transcription.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser-side Forge API used by the in-app AI chat.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Umami analytics. Leaving these unset is fine; the build prints two warnings
# about the unresolved placeholders in index.html and works normally.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
